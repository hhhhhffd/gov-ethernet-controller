# Production-like Compose profile. Generate every secret locally; do not commit
# a populated copy of this file.
LINKWATCH_ENV=production
LINKWATCH_POSTGRES_DB=linkwatch
LINKWATCH_POSTGRES_USER=linkwatch
LINKWATCH_POSTGRES_PASSWORD=replace-with-a-local-random-password
LINKWATCH_POSTGRES_PORT=5433
LINKWATCH_PUBLIC_HOST=monitoring.example
# Optional override for the startup readiness probe; it must be the public Caddy HTTPS URL.
LINKWATCH_PUBLIC_URL=https://monitoring.example
LINKWATCH_TLS_EMAIL=ops@example.com
LINKWATCH_HTTP_PORT=80
LINKWATCH_HTTPS_PORT=443
LINKWATCH_BACKEND_SUBNET=172.30.0.0/24
LINKWATCH_TRUSTED_PROXY_CIDRS=172.30.0.10/32
LINKWATCH_SEED_DEMO=0
LINKWATCH_AUTH_DISABLED=0
LINKWATCH_BOOTSTRAP_ADMIN_USERNAME=admin
LINKWATCH_BOOTSTRAP_ADMIN_PASSWORD=replace-with-12-plus-character-password
LINKWATCH_SESSION_TTL_SECONDS=28800
LINKWATCH_MAX_BACKFILL_DAYS=90
LINKWATCH_OLLAMA_URL=http://127.0.0.1:11434
LINKWATCH_OLLAMA_MODEL=qwen3.5:9b-q6k
LINKWATCH_OLLAMA_TIMEOUT_SECONDS=15
LINKWATCH_OLLAMA_MAX_RETRIES=1
LINKWATCH_CORS_ORIGINS=https://monitoring.example
LINKWATCH_PROVIDER_TRANSPORT=webhook
LINKWATCH_PROVIDER_WEBHOOK_URL=https://provider.example/api/cases
LINKWATCH_PROVIDER_WEBHOOK_TOKEN=replace-with-provider-token
LINKWATCH_NOTIFICATION_TRANSPORT=webhook
LINKWATCH_NOTIFICATION_WEBHOOK_URL=https://notifications.example/api/events
LINKWATCH_NOTIFICATION_WEBHOOK_TOKEN=replace-with-notification-token
