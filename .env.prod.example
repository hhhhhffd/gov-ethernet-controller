# Production-like local staging profile. Do not commit a real password here.
VKO_ENV=staging
VKO_AUTO_SEED=1
VKO_AUTH_MODE=password
# Set these only for a first production bootstrap, then remove them.
VKO_BOOTSTRAP_ADMIN_USERNAME=
VKO_BOOTSTRAP_ADMIN_PASSWORD=
VKO_SESSION_TTL_SECONDS=28800
VKO_MAX_BACKFILL_DAYS=90
VKO_POSTGRES_DB=vko
VKO_POSTGRES_USER=vko
VKO_POSTGRES_PASSWORD=replace-with-a-local-random-password
VKO_POSTGRES_PORT=5433
VKO_APP_PORT=8000
VKO_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
VKO_DB_POOL=1
VKO_DB_POOL_MIN=1
VKO_DB_POOL_MAX=10

# staging records hand-offs internally; production should use webhook or smtp.
VKO_PROVIDER_TRANSPORT=internal
VKO_PROVIDER_WEBHOOK_URL=
VKO_PROVIDER_WEBHOOK_TOKEN=
VKO_NOTIFICATION_TRANSPORT=internal
VKO_NOTIFICATION_WEBHOOK_URL=
VKO_NOTIFICATION_WEBHOOK_TOKEN=

# Used by the WSL agent script after the app is published on localhost.
VKO_SERVER_URL=http://127.0.0.1:8000
VKO_DEVICE_ID=device-42-primary
VKO_DEVICE_TOKEN=replace-with-a-registered-device-token
VKO_BUFFER_PATH=.vko-agent/prod-queue.sqlite3
VKO_PROBE=network
VKO_PROBE_TARGETS=https://www.google.com/generate_204
VKO_PROBE_HOST=1.1.1.1
VKO_PROBE_PORT=443
VKO_THROUGHPUT_URL=https://speed.cloudflare.com/__down?bytes=1000000
