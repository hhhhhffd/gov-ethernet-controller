# Production-like local staging profile. Do not commit a real password here.
VKO_ENV=staging
VKO_AUTO_SEED=1
VKO_POSTGRES_DB=vko
VKO_POSTGRES_USER=vko
VKO_POSTGRES_PASSWORD=replace-with-a-local-random-password
VKO_POSTGRES_PORT=5433
VKO_APP_PORT=8000
VKO_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Used by the WSL agent script after the app is published on localhost.
VKO_SERVER_URL=http://127.0.0.1:8000
VKO_DEVICE_ID=device-42-primary
VKO_DEVICE_TOKEN=replace-with-a-registered-device-token
VKO_BUFFER_PATH=.vko-agent/prod-queue.sqlite3
