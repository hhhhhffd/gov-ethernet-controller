VKO_ENV=demo
VKO_AUTH_MODE=password
VKO_SESSION_TTL_SECONDS=28800
VKO_MAX_BACKFILL_DAYS=90
VKO_DB_PATH=vko_mvp.db
VKO_SERVER_URL=http://127.0.0.1:8000
VKO_DEVICE_ID=device-42-primary
VKO_SCHOOL_ID=school-42
VKO_LINE_ID=line-42-primary
VKO_POINT_ID=point-42-primary
VKO_DEVICE_TOKEN=demo-device-42-primary-token
VKO_BUFFER_PATH=.vko-agent/queue.sqlite3
VKO_TESTS_PER_DAY=4
VKO_JITTER_MINUTES=8
VKO_LIGHT_CHECKS_BETWEEN=0
VKO_PROBE=demo
