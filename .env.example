VKO_PROBE_TARGETS=https://www.google.com/generate_204
VKO_PROBE_HOST=1.1.1.1
VKO_PROBE_PORT=443
VKO_THROUGHPUT_URL=https://speed.cloudflare.com/__down?bytes=1000000
VKO_UPLOAD_URL=
VKO_PROBE_TIMEOUT_SECONDS=5
