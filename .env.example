# Local development profile. Compose starts PostgreSQL and seeds deterministic demo data.
LINKWATCH_ENV=development
LINKWATCH_AUTH_DISABLED=0
LINKWATCH_SEED_DEMO=1
LINKWATCH_DATABASE_URL=postgres://linkwatch:linkwatch-dev-password@localhost:5432/linkwatch?sslmode=disable
LINKWATCH_SERVER_PORT=8080
LINKWATCH_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
LINKWATCH_SESSION_TTL_SECONDS=28800
LINKWATCH_MAX_BACKFILL_DAYS=90

# Agent defaults (the Rust binary also accepts VKO_* compatibility aliases).
LINKWATCH_SERVER_URL=http://127.0.0.1:8080
LINKWATCH_DEVICE_ID=device-42-primary
LINKWATCH_DEVICE_TOKEN=demo-device-42-primary-token
LINKWATCH_SCHOOL_ID=school-42
LINKWATCH_LINE_ID=line-42-primary
LINKWATCH_MONITORING_POINT_ID=point-42-primary
LINKWATCH_QUEUE_DIR=.linkwatch-agent/queue
LINKWATCH_TESTS_PER_DAY=4
LINKWATCH_JITTER_MINUTES=8
LINKWATCH_USE_SERVER_CONFIG=0
LINKWATCH_PROBE=demo
